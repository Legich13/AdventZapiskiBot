    {
      "id": "REQ-002",
      "type": "functional",
      "statement": "Авторский календарь",
      "acceptance": [
        {
          "id": "AC-002",
          "statement": "Автор сохраняет черновик, выбирает текст на каждый отмеченный день, публикует после заполнения и исправляет будущие записки."
        }
      ]
    },
    {
      "id": "REQ-003",
      "type": "functional",
      "statement": "Вручение и доступ",
      "acceptance": [
        {
          "id": "AC-003",
          "statement": "При первом запуске ник сопоставляется без учёта регистра. Получатель закреплён за Telegram ID и имеет один опубликованный календарь за месяц. Первое открытие с московской полуночи сохраняется однократно."
        }
      ]
    },
    {
      "id": "REQ-004",
      "type": "functional",
      "statement": "Виджеты",
      "acceptance": [
        {
          "id": "AC-004",
          "statement": "Календарь и карточка используют один обработчик, сохраняют дату старого сообщения, ограничивают HTML и ответ в байтах, скрывают будущие записки."
        }
      ]
    },
    {
      "id": "REQ-005",
      "type": "functional",
      "statement": "Утренние сообщения",
      "acceptance": [
        {
          "id": "AC-005",
          "statement": "Получатель, привязанный к 10:00 МСК, получает отдельную карточку, в том числе после утреннего открытия. Нет подарка — нет отправки. 429 откладывает повтор, неоднозначный результат исключает автоматический дубль."
        }
      ]
    },
    {
      "id": "REQ-006",
      "type": "functional",
      "statement": "Локальный просмотр и сотрудники",
      "acceptance": [
        {
          "id": "AC-006",
          "statement": "Локально доступны форма, часы, тестовые роли и реальные виджеты. Панель показывает автора, получателя, открытия и доставку. В production тестовые маршруты отсутствуют."
        }
      ]
    },
    {
      "id": "REQ-007",
      "type": "constraint",
      "statement": "Код, профильные справочники и OpenAPI удовлетворяют применимым контрактам Jobgram.",
      "acceptance": [
        {
          "id": "AC-007",
          "statement": "Архитектурные тесты проверяют слои, DTO и поля моделей. Сотрудник открывает документацию и Scalar. Бизнес-процессы содержат ссылки на актуальные операции."
        }
      ]
    }
