    "components": {
        "securitySchemes": {
            "editorSession": {
                "type": "apiKey",
                "in": "cookie",
                "name": "dekabr-cudes-session"
            },
            "csrf": {
                "type": "apiKey",
                "in": "header",
                "name": "X-CSRF-TOKEN"
            },
            "miniAppLaunch": {
                "type": "apiKey",
                "in": "header",
                "name": "X-Mini-App-Launch"
            },
            "telegramWebhook": {
                "type": "apiKey",
                "in": "header",
                "name": "X-Telegram-Bot-Api-Secret-Token"
            }
        },
        "schemas": {
            "CalendarIdResource": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer"
                    }
                },
                "required": [
                    "id"
                ],
                "title": "CalendarIdResource"
            },
            "MiniAppLoginRequest": {
                "type": "object",
                "properties": {
                    "initData": {
                        "type": "string",
                        "maxLength": 16384
                    }
                },
                "required": [
                    "initData"
                ],
                "title": "MiniAppLoginRequest"
            },
            "OpenedGiftResource": {
                "type": "object",
                "properties": {
                    "text": {
                        "type": "string"
                    },
                    "first": {
                        "type": "boolean"
                    }
                },
                "required": [
                    "text",
                    "first"
                ],
                "title": "OpenedGiftResource"
            },
            "SaveCalendarRequest": {
                "anyOf": [
                    {
                        "type": "object",
                        "properties": {
                            "month": {
                                "type": "string",
                                "pattern": "^[1-9][0-9]{3}-"
                            },
                            "target": {
                                "type": "string",
                                "const": "self"
                            },
                            "days": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "date": {
                                            "type": "string",
                                            "format": "date"
                                        },
                                        "text": {
                                            "type": [
                                                "string",
                                                "null"
                                            ],
                                            "maxLength": 1024
                                        }
                                    },
                                    "required": [
                                        "date",
                                        "text"
                                    ]
                                },
                                "maxItems": 31,
                                "uniqueItems": true
                            }
                        },
                        "required": [
                            "month",
                            "target",
                            "days"
                        ]
                    },
                    {
                        "type": "object",
                        "properties": {
                            "month": {
                                "type": "string",
                                "pattern": "^[1-9][0-9]{3}-"
                            },
                            "target": {
                                "type": "string",
                                "const": "username"
                            },
                            "username": {
                                "type": "string",
                                "pattern": "^@?[a-zA-Z][a-zA-Z0-9_]{0,31}$"
                            },
                            "days": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "date": {
                                            "type": "string",
                                            "format": "date"
                                        },
                                        "text": {
                                            "type": [
                                                "string",
                                                "null"
                                            ],
                                            "maxLength": 1024
                                        }
                                    },
                                    "required": [
                                        "date",
                                        "text"
                                    ]
                                },
                                "maxItems": 31,
                                "uniqueItems": true
                            }
                        },
                        "required": [
                            "month",
                            "target",
                            "username",
                            "days"
                        ]
                    }
                ],
                "title": "SaveCalendarRequest"
            },
            "TelegramWebhookRequest": {
                "type": "object",
                "properties": {
                    "update_id": {
                        "type": "integer",
                        "minimum": 0
                    },
                    "message": {
                        "type": "object",
                        "properties": {
                            "text": {
                                "type": "string"
                            },
                            "chat": {
                                "type": "object",
                                "properties": {
                                    "id": {
                                        "type": "integer"
                                    },
                                    "type": {
                                        "type": "string"
                                    }
                                }
                            },
                            "from": {
                                "type": "object",
                                "properties": {
                                    "id": {
                                        "type": "integer",
                                        "minimum": 1
                                    },
                                    "username": {
                                        "type": [
                                            "string",
                                            "null"
                                        ],
                                        "maxLength": 32
                                    }
                                }
                            }
                        }
                    },
                    "widget_query": {
                        "type": "object",
                        "properties": {
                            "id": {
                                "type": "string",
                                "maxLength": 128
                            },
                            "message_id": {
                                "type": "integer",
                                "minimum": 1
                            },
                            "data": {
                                "type": "string",
                                "maxLength": 64
                            },
                            "from": {
                                "type": "object",
                                "properties": {
                                    "id": {
                                        "type": "integer",
                                        "minimum": 1
                                    }
                                },
                                "required": [
                                    "id"
                                ]
                            },
                            "chat": {
                                "type": "object",
                                "properties": {
                                    "type": {
